{
  "id": "warranty-vault",
  "name": "Warranty Vault",
  "version": "1.2.0",
  "description": "A receipt and warranty vault for the things you own \u2014 purchase dates, serial numbers, receipt photos, and a heads-up before each warranty runs out.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "warranty",
    "receipts",
    "purchases",
    "home",
    "documents"
  ],
  "icon": "\ud83e\uddfe",
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": [
      "family.documents"
    ]
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "items": {"sql": "SELECT id, name, category, purchase_date, price_cents, retailer, warranty_months, warranty_expires_date, serial_number, notes, receipt_file_id, receipt_doc_id, created_by, created_at, updated_at FROM app_warranty_vault__items"}
  },
  "automation_actions": {
    "add_item": {
      "title": "Track a warranty",
      "description": "Start tracking a purchase's warranty when another app's event fires \u2014 an appliance bought, a tool registered, equipment added elsewhere.",
      "params": {
        "created_by": {
          "type": "member",
          "label": "Added by",
          "required": true
        },
        "name": {
          "type": "text",
          "label": "What was bought",
          "required": true
        },
        "category": {
          "type": "text",
          "label": "Category",
          "default": "other",
          "options": [
            "electronics",
            "appliances",
            "furniture",
            "tools",
            "outdoor",
            "other"
          ]
        },
        "retailer": {
          "type": "text",
          "label": "Retailer",
          "default": ""
        }
      },
      "dedupe": {
        "table": "items",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "items",
          "values": {
            "id": "$uuid",
            "name": ":name",
            "category": ":category",
            "retailer": ":retailer",
            "created_by": ":created_by",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "db_plaintext_columns": [
    "purchase_date",
    "warranty_expires_date"
  ],
  "member_references": {
    "items": {
      "column": "created_by",
      "on_removed": "keep"
    }
  },
  "row_policies": {
    "items": {
      "kind": "adult_writable"
    }
  },
  "delete_file_columns": {
    "items": [
      "receipt_file_id"
    ]
  },
  "document_acls": {
    "write": {
      "require_role": "adult"
    }
  },
  "file_acls": {
    "write": {
      "require_role": "adult"
    },
    "read": "document_acl"
  },
  "publishes": [
    "warranty.item_added"
  ],
  "publish_acls": {
    "warranty.item_added": {
      "require_role": "adult"
    }
  },
  "nav": {
    "label": "Warranties"
  },
  "agenda": {
    "kind": "reminder",
    "label": "Warranty ends today",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, name AS title, NULLIF(retailer, '') AS subtitle, warranty_expires_date AS when_at FROM app_warranty_vault__items WHERE warranty_expires_date = :today ORDER BY created_at LIMIT 20"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT name AS title, category AS subtitle, warranty_expires_date AS expires_on FROM app_warranty_vault__items WHERE warranty_expires_date <> '' AND warranty_expires_date >= :today ORDER BY warranty_expires_date LIMIT 3"
    },
    "display": {
      "template": "list",
      "title": "title",
      "subtitle": "subtitle",
      "when": "expires_on"
    }
  },
  "resource_limits": {
    "max_db_bytes": 52428800,
    "max_file_bytes": 10485760,
    "max_files_bytes": 524288000
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": [
      "items"
    ]
  }
}
